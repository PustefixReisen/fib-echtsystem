# FIB runtime configuration – no secrets belong in Git.

# PostgreSQL connection used by the server-side FIB fachservices.
# In production/pustivo this must authenticate as the dedicated fib_app login role.
FIB_DATABASE_URL=postgresql://fib_app:<set-as-server-secret>@<host>:5432/postgres

# Logical application schema. Keep fixed unless an explicit migration decision changes it.
FIB_DATABASE_SCHEMA=fib

# Supabase project URL used for authentication flows only.
SUPABASE_URL=https://<project-ref>.supabase.co

# Public/publishable key may be used by the editorial frontend for Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=<set-in-environment>

# Do not place service_role / secret keys here unless a narrowly defined technical task
# explicitly requires them. Normal FIB fach access uses fib_app, not service_role.
